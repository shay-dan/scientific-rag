GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER_ORDER=groq,openrouter,gemini
# Role-specific overrides let inexpensive Groq handle planning while the tested
# citation-compliant models handle final synthesis.
LLM_PROVIDER_ORDER_EXPERT=openrouter,gemini,groq
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
OPENROUTER_MODEL_EXPERT=qwen/qwen3.6-35b-a3b
MODEL_EXPERT=gemini-3.8-flash
# Query repair runs only after two deterministic searches return no accepted source.
GROQ_MODEL_QUERY_REPAIR=openai/gpt-oss-20b
OPENROUTER_MODEL_QUERY_REPAIR=qwen/qwen3.6-35b-a3b
MODEL_QUERY_REPAIR=gemini-2.5-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=90
# Per-provider attempt budgets (also capped by LLM_REQUEST_TIMEOUT_SECONDS).
LLM_GROQ_TIMEOUT_SECONDS=20
LLM_OPENROUTER_TIMEOUT_SECONDS=60
# Expert contexts above this size skip OpenRouter when another provider is available.
# Paid Qwen is allowed a bounded scientific context. Set 0 to disable.
LLM_OPENROUTER_EXPERT_MAX_CONTEXT_CHARS=12000
LLM_GEMINI_TIMEOUT_SECONDS=45
# Temporary provider cooldown after a 429 or repeated transient failures.
# A Retry-After response header takes precedence when present.
LLM_PROVIDER_COOLDOWN_SECONDS=60
# Only retry a previously skipped provider after Gemini fails if this much call time remains.
LLM_RECOVERY_MIN_REMAINING_SECONDS=10
# Shared Redis admission budgets; conservative defaults, not your provider account limits.
# Set these below the limits shown in your Groq/OpenRouter dashboards.
LLM_GROQ_RPM_BUDGET=20
LLM_GROQ_TPM_BUDGET=6000
LLM_OPENROUTER_RPM_BUDGET=10
LLM_OPENROUTER_TPM_BUDGET=0
# 0 disables a proactive budget; Gemini remains available for fallback.
LLM_GEMINI_RPM_BUDGET=0
LLM_GEMINI_TPM_BUDGET=0
LLM_GROQ_GATEKEEPER_WAIT_SECONDS=4
LLM_EXPERT_OUTPUT_RESERVE_TOKENS=3000
# Per-source mining and per-paper relevance-screen budgets.
PUBMED_FETCH_TIMEOUT_SECONDS=90
ENTREZ_REQUEST_TIMEOUT_SECONDS=8
MINING_SOURCE_TIMEOUT_SECONDS=150
RELEVANCE_SCREEN_TIMEOUT_SECONDS=55
ARXIV_CONNECT_TIMEOUT_SECONDS=5
ARXIV_READ_TIMEOUT_SECONDS=25
ARXIV_FETCH_ATTEMPTS=2
ARXIV_RETRY_BACKOFF_SECONDS=2
# arXiv coordination is shared through Redis across worker processes. Successful
# search pages may be reused except when cache_mode=refresh_sources.
ARXIV_REQUEST_INTERVAL_SECONDS=3
ARXIV_MAX_RETRY_AFTER_SECONDS=60
ARXIV_SEARCH_CACHE_TTL_SECONDS=21600
ARXIV_DISTRIBUTED_COORDINATION_ENABLED=true
OPENROUTER_SITE_URL=https://github.com/shay-dan/scientific-rag
OPENROUTER_APP_NAME=Scientific RAG
# The app includes dated default rates for the configured Groq, OpenRouter,
# Gemini generation and Gemini embedding models. Model-specific or provider-wide
# LLM_*_INPUT/OUTPUT_USD_PER_MILLION variables override those defaults.
COST_TRACKING_ENABLED=true
COST_ENFORCE_HARD_LIMIT=true
COST_DAILY_BUDGET_USD=5.00
COST_MONTHLY_BUDGET_USD=50.00
COST_SOFT_ALERT_PERCENT=80
# Conservative pre-flight reservations. Actual measured/estimated spend replaces
# the reservation after a completed run; queued requests cannot race past a limit.
COST_FAST_RESERVATION_USD=0.05
COST_STANDARD_RESERVATION_USD=0.20
COST_DEEP_RESERVATION_USD=0.75
# Ragas and diagnostic judges do not consistently expose token usage, so their
# per-case reservation remains a clearly labeled conservative upper bound.
COST_EVALUATION_JUDGE_RESERVATION_USD_PER_CASE=0.10
ENTREZ_EMAIL=you@example.com
DATABASE_URL=postgresql+asyncpg://scientific_rag:scientific_rag@localhost:5432/scientific_rag
REQUEST_TIMEOUT_SECONDS=600
DEEP_RESEARCH_TIMEOUT_SECONDS=900
EVALUATION_JOB_TIMEOUT_SECONDS=3600
EVALUATION_CASE_TIMEOUT_SECONDS=300
CLAIM_DIAGNOSTIC_TIMEOUT_SECONDS=120
# Semantic claim verification is opt-in. Keep off until Stage 1D is complete.
SEMANTIC_CLAIM_VERIFICATION_MODE=off
ALLOW_DATABASE_RESET=false
EMBEDDING_MODEL=gemini-embedding-2
RAGAS_JUDGE_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSIONS=768
ENABLE_DEEP_RESEARCH=false
ALLOW_EVALUATION_DATASET=false
APP_API_KEYS=admin:replace-with-a-long-random-access-key
HEALTH_COACH_API_KEY=replace-with-a-different-long-random-service-key
APP_SESSION_SECRET=replace-with-a-different-32-character-minimum-secret
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set true behind HTTPS in staging/production. Leave false for local HTTP only.
APP_SECURE_COOKIES=false
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RESEARCH_RUNS_PER_DAY=10
DEEP_RESEARCH_RUNS_PER_DAY=1
REDIS_URL=redis://redis:6379/0
